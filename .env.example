SPRING_DATASOURCE_URL=jdbc:mysql://RDS_ENDPOINT:3306/ttdd?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ttdd_admin
SPRING_DATASOURCE_PASSWORD=

# access/refresh 토큰 서명용 비밀키. 없으면 애플리케이션이 기동 자체를 실패한다(application.yaml
# 참고 - 운영 배포 사고를 막기 위해 기본값을 의도적으로 두지 않았다). 충분히 긴 랜덤 문자열로 채울 것.
JWT_SECRET=
CLIENT_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
